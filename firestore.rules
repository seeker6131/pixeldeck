rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // each signed-in player can read and write only their own save
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // player market: anyone signed in can browse and buy, a listing must carry the seller's own id
    match /market/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.seller == request.auth.uid
        && request.resource.data.p is int
        && request.resource.data.p >= 100 && request.resource.data.p <= 99900;
      allow delete: if request.auth != null;
    }
    // sale proceeds waiting for the seller to collect
    match /payouts/{id} {
      allow create: if request.auth != null
        && request.resource.data.gold is int
        && request.resource.data.gold >= 0 && request.resource.data.gold <= 99900;
      allow read, delete: if request.auth != null && resource.data.to == request.auth.uid;
    }
  }
}
